# ─── VOILE Backend Environment Variables ───
# Copy this to `.env` and adjust as needed.

# VTON provider: "hf_dev" (free HF Space) | "fal" (fal.ai, needs API key)
VTON_PROVIDER=hf_dev

# HF Space to use for dev/prototype inference
HF_SPACE_ID=yisol/IDM-VTON

# fal.ai API key (only needed if VTON_PROVIDER=fal)
FAL_KEY=

# Redis URL
REDIS_URL=redis://localhost:6379

# SQLite database path (relative to backend/)
DATABASE_PATH=./voile.db

# Upload directory (relative to backend/)
UPLOAD_DIR=./uploads

# Rate limit: max try-on requests per IP per hour
RATE_LIMIT_PER_HOUR=10

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
